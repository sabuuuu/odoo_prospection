# --- Odoo Configuration ---
ODOO_URL=https://votre-instance.odoo.com
ODOO_DB=votre_nom_de_base
ODOO_USER=votre_email@domaine.com
ODOO_API_KEY=votre_cle_api_odoo

# --- Odoo Stages & Pipeline ---
# Étape où créer les nouveaux leads
ODOO_TARGET_STAGE=Liste Restaurant
ODOO_DEDUP_STAGES=Liste Restaurant,À contacter

# --- Pappers API Configuration ---
# Obtenez votre clé sur https://www.pappers.fr/api
PAPPERS_API_KEY=votre_cle_api_pappers

# --- Claude AI (Anthropic) Configuration ---
# Obtenez votre clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Web Search Enrichment (Optionnel mais recommandé) ---
# Obtenez une clé gratuite sur https://serper.dev (2 500 requêtes gratuites)
SERPER_API_KEY=votre_cle_serper

# --- Paramètres de Prospection (Ciblage) ---
# Tous types de restaurants (5610A: Traditionnelle, 5610B: Cafétérias/Libre-service, 5610C: Restauration rapide)
TARGET_NAF_CODES=5610A,5610B,5610C
# Département Moselle (57) pour Metz et ses alentours
TARGET_DEPARTMENTS=57
# Chiffre d'affaires minimum en euros (Optionnel, 0 pour aucun filtre)
MIN_TURNOVER=0
# Nombre maximum de prospects à traiter par exécution quotidienne
DAILY_PROSPECT_LIMIT=10
